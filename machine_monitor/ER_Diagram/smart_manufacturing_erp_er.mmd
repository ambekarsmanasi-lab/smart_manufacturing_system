erDiagram
    ProductionLine {
        int line_id
        string name
    }
    Machine {
        int machine_id
        int line_id
        string name
        string machine_type
        string criticality
    }
    Sensor {
        int sensor_id
        int machine_id
        string sensor_type
        string unit
    }
    SensorReading {
        int reading_id
        int sensor_id
        datetime recorded_at
        string value
    }
    FaultType {
        int fault_type_id
        string fault_code
        string name
        datetime category
        string recommended_action
    }
    Fault {
        int fault_id
        int machine_id
        int fault_type_id
        string severity
        datetime status
        string confidence
        datetime detected_at
        datetime last_seen_at
        string occurrence_count
        datetime resolved_at
    }
    FaultEvidence {
        int fault_id
        int sensor_id
        string observed_value
        string expected_value
        string unit
    }
    User {
        int id
        string username
        string role
    }
    Technician {
        int technician_id
        int unique_user_id
        string availability
        string max_active_orders
    }
    Skill {
        int skill_id
        string name
    }
    TechnicianSkill {
        int technician_id
        int skill_id
        string proficiency
    }
    FaultTypeSkill {
        int fault_type_id
        int skill_id
        string min_proficiency
    }
    WorkOrder {
        int work_order_id
        int fault_id
        int assigned_to
        int assigned_by
        string suggested_technician_id
        string assignment_method
        string priority
        datetime status
        string instructions
    }
    WorkOrderActivity {
        int activity_id
        int work_order_id
        string recorded_by
        string activity_type
        datetime recorded_at
    }
    WorkOrderReport {
        int report_id
        int work_order_id
        string findings
        string action_taken
        string parts_used
        datetime review_status
        string reviewed_by
    }
    ProductionLine ||--o{ Machine : "contains"
    Machine ||--o{ Sensor : "has"
    Sensor ||--o{ SensorReading : "records"
    Machine ||--o{ Fault : "has"

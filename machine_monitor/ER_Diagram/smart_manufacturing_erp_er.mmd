    Technician ||--o{ TechnicianSkill : "has skills"
    Skill ||--o{ TechnicianSkill : "is held by"
    FaultType ||--o{ FaultTypeSkill : "requires"
    Skill ||--o{ FaultTypeSkill : "qualifies"
